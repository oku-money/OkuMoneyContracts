{
  "name": "okumoney-evm-contracts",
  "version": "1.0.0",
  "description": "OkuMoney EVM smart contracts - Yield-bearing stablecoin",
  "author": "OkuMoney",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "compile": "hardhat compile",
    "clean": "hardhat clean && forge clean && rm -rf cache_hardhat typechain-types",
    "typechain": "hardhat typechain",

    "export-abis": "ts-node scripts/utils/exportAbis.ts",

    "test": "hardhat test",
    "test:forge": "forge test",
    "test:all": "forge test && hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",

    "node": "hardhat node",
    "node:sepolia": "hardhat node --fork $(grep SEPOLIA_RPC_URL .env | cut -d '=' -f2)",
    "node:mainnet": "hardhat node --fork $(grep MAINNET_RPC_URL .env | cut -d '=' -f2)",

    "deploy": "hardhat run scripts/deploy/index.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy/index.ts --network sepolia",
    "deploy:opSepolia": "hardhat run scripts/deploy/index.ts --network opSepolia",
    "deploy:baseSepolia": "hardhat run scripts/deploy/index.ts --network baseSepolia",
    "deploy:bscTestnet": "hardhat run scripts/deploy/index.ts --network bscTestnet",
    "deploy:base": "hardhat run scripts/deploy/index.ts --network base",
    "deploy:bsc": "hardhat run scripts/deploy/index.ts --network bsc",

    "verify:sepolia": "hardhat run scripts/deploy/verify.ts --network sepolia",
    "verify:baseSepolia": "hardhat run scripts/deploy/verify.ts --network baseSepolia",
    "verify:bscTestnet": "hardhat run scripts/deploy/verify.ts --network bscTestnet",
    "verify:base": "hardhat run scripts/deploy/verify.ts --network base",
    "verify:bsc": "hardhat run scripts/deploy/verify.ts --network bsc",

    "upgrade": "hardhat run scripts/upgrade/index.ts --network localhost",
    "upgrade:sepolia": "NETWORK=sepolia hardhat run scripts/upgrade/index.ts --network sepolia",
    "upgrade:opSepolia": "NETWORK=opSepolia hardhat run scripts/upgrade/index.ts --network opSepolia",
    "upgrade:baseSepolia": "NETWORK=baseSepolia hardhat run scripts/upgrade/index.ts --network baseSepolia",
    "upgrade:bscTestnet": "NETWORK=bscTestnet hardhat run scripts/upgrade/index.ts --network bscTestnet",
    "upgrade:base": "NETWORK=base hardhat run scripts/upgrade/index.ts --network base",
    "upgrade:bsc": "NETWORK=bsc hardhat run scripts/upgrade/index.ts --network bsc",

    "test:onchain": "NETWORK=sepolia hardhat run scripts/test/test-onchain.ts --network localhost",
    "test:onchain:sepolia": "NETWORK=sepolia hardhat run scripts/test/test-onchain.ts --network sepolia",
    "test:onchain:baseSepolia": "NETWORK=baseSepolia hardhat run scripts/test/test-onchain.ts --network baseSepolia",
    "test:onchain:bscTestnet": "NETWORK=bscTestnet hardhat run scripts/test/test-onchain.ts --network bscTestnet",

    "bridge:evm": "ts-node --transpile-only scripts/test/bridge-evm-evm.ts",

    "operator:mint": "hardhat run scripts/operator/mintOkuM.ts",
    "operator:redeem": "hardhat run scripts/operator/redeemOkuM.ts",
    "operator:depositBuffer": "hardhat run scripts/operator/depositBuffer.ts",
    "operator:withdrawBuffer": "hardhat run scripts/operator/withdrawBuffer.ts",
    "operator:processQueue": "hardhat run scripts/operator/processQueue.ts",
    "operator:configureMinterAllowance": "hardhat run scripts/operator/configureMinterAllowance.ts",
    "operator:configureOracle": "hardhat run scripts/operator/configureOracle.ts",
    "operator:distributeYield": "hardhat run scripts/operator/distributeYield.ts",
    "operator:pause": "hardhat run scripts/operator/pause.ts",
    "operator:unpause": "hardhat run scripts/operator/unpause.ts",
    "operator:rescueQueueEntry": "hardhat run scripts/operator/rescueQueueEntry.ts",
    "operator:grantRoles": "hardhat run scripts/operator/grantRoles.ts",
    "operator:grantRolesMainnet": "hardhat run scripts/operator/grantRolesMainnet.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/bs58": "^4.0.4",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.6",
    "bs58": "^6.0.0",
    "chai": "^4.3.10",
    "dotenv": "^17.2.3",
    "ethers": "^6.9.2",
    "hardhat": "^2.19.4",
    "hardhat-deploy": "^0.12.1",
    "hardhat-deploy-ethers": "^0.4.2",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "solidity",
    "ethereum",
    "smart-contracts",
    "hardhat",
    "foundry",
    "stablecoin",
    "defi"
  ]
}
