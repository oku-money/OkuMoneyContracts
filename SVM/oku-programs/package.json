{
  "license": "ISC",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "build": "anchor build",
    "test": "anchor test --validator legacy",
    "test:all": "anchor test --validator legacy && npm run test:fork",
    "test:unit": "anchor test --validator legacy",
    "test:fuzz": "npx mocha --require tsx --timeout 1000000 --grep 'Fuzz' 'tests/**/*.ts'",
    "test:invariant": "npx mocha --require tsx --timeout 1000000 --grep 'Invariant' 'tests/**/*.ts'",
    "test:fork": "tsx scripts/test-fork.ts",
    "test:fork:devnet": "tsx scripts/test-fork-devnet.ts",
    "test:fork:bridge": "tsx scripts/test-fork-devnet.ts --bridge",
    "test:surfpool": "anchor test",
    "deploy": "npm run deploy:devnet-fork",
    "deploy:localnet": "NETWORK=localnet tsx scripts/deploy/index.ts",
    "deploy:devnet": "NETWORK=devnet tsx scripts/deploy/index.ts",
    "deploy:devnet:yes": "NETWORK=devnet tsx scripts/deploy/index.ts --yes",
    "deploy:devnet-fork": "NETWORK=devnet-fork tsx scripts/deploy/index.ts",
    "deploy:mainnet": "NETWORK=mainnet-beta tsx scripts/deploy/index.ts",
    "deploy:mainnet-fork": "NETWORK=mainnet-fork tsx scripts/deploy/index.ts",
    "deploy:programs": "NETWORK=devnet tsx scripts/deploy/deploy-programs.ts",
    "deploy:programs:fork": "NETWORK=devnet-fork tsx scripts/deploy/deploy-programs.ts",
    "deploy:init": "NETWORK=devnet tsx scripts/deploy/deploy-init.ts",
    "deploy:init:fork": "NETWORK=devnet-fork tsx scripts/deploy/deploy-init.ts",
    "surfpool:devnet": "surfpool start --network devnet --airdrop-keypair-path /dev/null",
    "surfpool:mainnet": "surfpool start --network mainnet --airdrop-keypair-path /dev/null",
    "wallet:check": "tsx -e \"import { createProvider } from './scripts/utils/network'; const p = createProvider('devnet'); console.log('Wallet:', p.wallet.publicKey.toBase58()); p.connection.getBalance(p.wallet.publicKey).then(b => console.log('Balance on devnet:', b / 1e9, 'SOL'));\"",
    "simulate:full": "tsx scripts/simulate/full-flow.ts",
    "simulate:verify": "tsx scripts/simulate/verify-state.ts",
    "test:flow:fork": "NETWORK=devnet-fork tsx scripts/devnet/test-devnet.ts",
    "test:flow:devnet": "NETWORK=devnet tsx scripts/devnet/test-devnet.ts",
    "test:devnet": "NETWORK=devnet tsx scripts/devnet/test-devnet.ts",
    "devnet:test": "NETWORK=devnet tsx scripts/devnet/test-devnet.ts",
    "devnet:test:state": "NETWORK=devnet tsx scripts/devnet/test-devnet.ts --step=state",
    "devnet:test:mint": "NETWORK=devnet tsx scripts/devnet/test-devnet.ts --step=mint",
    "devnet:test:transfer": "NETWORK=devnet tsx scripts/devnet/test-devnet.ts --step=transfer",
    "devnet:test:rebase": "NETWORK=devnet tsx scripts/devnet/test-devnet.ts --step=rebase",
    "devnet:test:wrap": "NETWORK=devnet tsx scripts/devnet/test-devnet.ts --step=wrap",
    "devnet:test:unwrap": "NETWORK=devnet tsx scripts/devnet/test-devnet.ts --step=unwrap",
    "devnet:test:redeem": "NETWORK=devnet tsx scripts/devnet/test-devnet.ts --step=redeem",
    "devnet:test:bridge": "NETWORK=devnet tsx scripts/devnet/test-devnet.ts --step=bridge",
    "cost": "tsx scripts/utils/calculateDeploymentCost.ts",
    "localnet:test": "NETWORK=localnet tsx scripts/devnet/test-devnet.ts",
    "localnet:test:state": "NETWORK=localnet tsx scripts/devnet/test-devnet.ts --step=state",
    "localnet:test:mint": "NETWORK=localnet tsx scripts/devnet/test-devnet.ts --step=mint",
    "localnet:start": "solana-test-validator --reset",
    "localnet:deploy:fresh": "rm -f deployments/localnet.json && npm run deploy:localnet",
    "localnet:full": "npm run deploy:localnet && npm run simulate:full",
    "fix:escrow": "NETWORK=devnet npx tsx scripts/deploy/fix-oku-money-escrow.ts",
    "fix:escrow:yes": "NETWORK=devnet npx tsx scripts/deploy/fix-oku-money-escrow.ts --yes",
    "fix:escrow:fork": "NETWORK=devnet-fork npx tsx scripts/deploy/fix-oku-money-escrow.ts",
    "clean": "anchor clean && rm -rf deployments/"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.0",
    "@noble/hashes": "^1.3.3",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/chai": "^4.3.4",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.3.4",
    "fast-check": "^4.6.0",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}
