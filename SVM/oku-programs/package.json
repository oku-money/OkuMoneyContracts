{
  "name": "okumoney-svm-programs",
  "license": "ISC",
  "scripts": {
    "build": "anchor build",
    "clean": "anchor clean && rm -f deployments/localnet.json",
    "export-idls": "tsx scripts/utils/exportIdls.ts",
    "deploy:programs": "NETWORK=devnet tsx scripts/deploy/deploy-programs.ts",
    "deploy:programs:devnet-fork": "NETWORK=devnet-fork tsx scripts/deploy/deploy-programs.ts",
    "deploy:programs:mainnet": "NETWORK=mainnet-beta tsx scripts/deploy/deploy-programs.ts",
    "deploy:init": "NETWORK=devnet tsx scripts/deploy/deploy-init.ts",
    "deploy:init:devnet-fork": "NETWORK=devnet-fork tsx scripts/deploy/deploy-init.ts",
    "deploy:init:mainnet": "NETWORK=mainnet-beta tsx scripts/deploy/deploy-init.ts",
    "test": "npm run test:rust && npm run test:bankrun",
    "test:rust": "cargo test --workspace --quiet",
    "test:bankrun": "RUST_LOG= npx mocha --require tsx --timeout 60000 'tests/bankrun/**/*.ts'",
    "test:fork": "RUST_LOG= npx mocha --require tsx --timeout 180000 'tests/fork/**/*.ts'",
    "test:onchain": "NETWORK=devnet tsx scripts/test/test-devnet.ts",
    "test:onchain:fork": "NETWORK=devnet-fork tsx scripts/test/test-devnet.ts",
    "admin:set-oracle": "tsx scripts/admin/set-oracle.ts",
    "admin:set-pyth-program-owner": "tsx scripts/admin/set-pyth-program-owner.ts",
    "admin:set-authority": "tsx scripts/admin/set-authority.ts",
    "admin:pause-psm": "tsx scripts/admin/pause-psm.ts",
    "admin:unpause-psm": "tsx scripts/admin/unpause-psm.ts",
    "admin:distribute-yield": "tsx scripts/admin/distribute-yield.ts",
    "admin:set-max-supply": "tsx scripts/admin/set-max-supply.ts",
    "admin:set-minter-allowance": "tsx scripts/admin/set-minter-allowance.ts",
    "admin:set-oku-m-price": "tsx scripts/admin/set-oku-m-price.ts",
    "admin:freeze-account": "tsx scripts/admin/freeze-account.ts",
    "admin:thaw-account": "tsx scripts/admin/thaw-account.ts",
    "admin:process-queue": "tsx scripts/admin/process-queue.ts",
    "admin:close-programs": "tsx scripts/admin/close-programs.ts",
    "upgrade": "tsx scripts/upgrade/index.ts",
    "upgrade:devnet": "NETWORK=devnet tsx scripts/upgrade/index.ts",
    "upgrade:mainnet": "NETWORK=mainnet-beta tsx scripts/upgrade/index.ts",
    "surfpool:devnet": "surfpool start --network devnet --airdrop-keypair-path /dev/null",
    "surfpool:mainnet": "surfpool start --network mainnet --airdrop-keypair-path /dev/null",
    "wallet:check": "tsx scripts/utils/check-wallet.ts",
    "cost": "tsx scripts/utils/calculateDeploymentCost.ts",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.0",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.4",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "anchor-bankrun": "^0.5.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "solana-bankrun": "^0.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}
