{
  "name": "okumoney-svm-programs",
  "license": "ISC",
  "scripts": {
    "build": "anchor build",
    "clean": "anchor clean && rm -f deployments/localnet.json",

    "deploy:programs": "NETWORK=devnet tsx scripts/deploy/deploy-programs.ts",
    "deploy:programs:devnet-fork": "NETWORK=devnet-fork tsx scripts/deploy/deploy-programs.ts",
    "deploy:programs:mainnet": "NETWORK=mainnet-beta tsx scripts/deploy/deploy-programs.ts",
    "deploy:init": "NETWORK=devnet tsx scripts/deploy/deploy-init.ts",
    "deploy:init:devnet-fork": "NETWORK=devnet-fork tsx scripts/deploy/deploy-init.ts",
    "deploy:init:mainnet": "NETWORK=mainnet-beta tsx scripts/deploy/deploy-init.ts",

    "test": "anchor test --validator legacy",
    "test:fork": "npx mocha --require tsx --timeout 1000000 'tests/fork/**/*.ts'",
    "test:onchain": "NETWORK=devnet tsx scripts/test/test-devnet.ts",
    "test:onchain:fork": "NETWORK=devnet-fork tsx scripts/test/test-devnet.ts",

    "bridge:state": "NETWORK=devnet tsx scripts/bridge/check-bridge-state.ts",
    "bridge:burn": "NETWORK=devnet tsx scripts/bridge/bridge-burn-to-evm.ts",
    "bridge:mint": "NETWORK=devnet tsx scripts/bridge/bridge-mint-from-evm.ts",

    "surfpool:devnet": "surfpool start --network devnet --airdrop-keypair-path /dev/null",
    "surfpool:mainnet": "surfpool start --network mainnet --airdrop-keypair-path /dev/null",

    "wallet:check": "tsx scripts/utils/check-wallet.ts",
    "cost": "tsx scripts/utils/calculateDeploymentCost.ts",

    "fix:fee-recipient": "NETWORK=devnet tsx scripts/deploy/fixes/fix-bridge-fee-recipient.ts",
    "fix:fee-recipient:yes": "NETWORK=devnet tsx scripts/deploy/fixes/fix-bridge-fee-recipient.ts --yes",

    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.0",
    "@noble/hashes": "^1.3.3",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/chai": "^4.3.4",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}
