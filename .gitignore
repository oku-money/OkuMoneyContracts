# Compiler files
cache/
out/
# Hardhat build output lives under EVM/artifacts/. The repo-root /artifacts/
# directory holds a curated set of ABIs and IDLs for downstream consumers
# (backend, SDKs, frontend) and IS tracked — see /artifacts/README.md.
/EVM/artifacts/

# Slither / Echidna / Crytic compilation exports
EVM/crytic-export/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
# docs/ intentionally tracked — runbooks and protocol documentation live here

# Dotenv file
.env

# Dependencies
node_modules/

# Coverage reports
coverage/
lcov.info

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Foundry
foundry.lock

# Hardhat
cache_hardhat/
typechain-types/

# TypeScript
dist/
*.tsbuildinfo

# Deployments (keep sepolia for reference)
deployments/*
!deployments/sepolia

# SVM deployment records — keep shared network records, ignore per-developer localnet
!SVM/oku-programs/deployments/
!SVM/oku-programs/deployments/devnet.json
!SVM/oku-programs/deployments/devnet-fork.json
!SVM/oku-programs/deployments/devnet-fork-verification.json
SVM/oku-programs/deployments/localnet.json

# Environment files
.env.local
.env.*.local

# Script run logs (auto-generated)
EVM/scripts/logs/*.jsonl

# Cross-chain global value sample store (auto-generated by
# scripts/operator/sampleGlobalValue.ts; reference-implementation local store,
# not a durable/shared record — see TRACKER.md).
EVM/scripts/config/globalValueSamples.json

# Carry ledger (auto-generated by scripts/utils/carryLedger.ts callers;
# reference-implementation local store, not a durable/shared record — see
# TRACKER.md).
EVM/scripts/config/carryLedger.json

# Epoch-schedule artifacts (auto-generated by
# scripts/operator/deriveEpochSchedule.ts / broadcastSchedule.ts; one
# (epochId, phase) JSON file per derivation — see scripts/utils/epochArtifact.ts).
EVM/scripts/config/epochs/

# Local-fork address book. Holds the `fork:<chain>` half of the address book,
# split out of the tracked addresses.json by scripts/utils/addressBook.ts.
# Every fork run (dryRunForks.sh, `npm run deploy --network localhost`, the
# hardhat drills) redeploys to a throwaway chain, so these addresses are
# ephemeral by construction and must never be committed.
EVM/scripts/config/addresses.local.json

# Anchor (Solana test artifacts)
.anchor/

# Cargo-fuzz corpus (auto-generated binary test inputs, reproducible by re-running fuzzer)
**/fuzz/corpus/

# Hardhat EDR cache
edr-cache/

# Local dry-run logs from scripts/deploy/dryRunForks.sh (ephemeral: wiped at the
# start of every run; the addresses it deploys land in the equally-ephemeral
# scripts/config/addresses.local.json, never in the tracked addresses.json).
EVM/.dry-run-logs/

# Live deploy logs (ad-hoc per-chain transcripts, machine-specific & ephemeral;
# safe to delete — canonical addresses live in testnet-addresses.json).
EVM/.live-deploy-logs/

# Rust build artifacts
target/

# Solana test validator data
test-ledger/
**/test-ledger/
**/validator*.log

# Surfpool simulation logs
.surfpool/
**/.surfpool/

# Random binaries
*.deb

# Vestigial root-level lib/ (submodules are registered under EVM/lib/ only)
/lib/

# Large log files
*.log
!*.changelog

# Development documentation (keep only top-level READMEs + TESTNET_DEPLOYMENT.md)
EVM/scripts/TEST_RESULTS.md
EVM/scripts/QUICKSTART.md
EVM/config/README.md
EVM/scripts/README.md
# Solana signing keypairs (never commit private keys)
**/keys/*.json
**/keys/**/*.json
*.keypair.json

# Claude Code local settings (machine-specific)
**/.claude/
