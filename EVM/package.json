{
  "name": "okumoney-contracts",
  "version": "1.0.0",
  "description": "OkuUSD smart contracts - Yield-bearing stablecoin backed by US T-Bills",
  "author": "OkuMoney",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:forge": "forge test",
    "test:hardhat": "hardhat test",
    "test:all": "forge test && hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "node": "hardhat node",
    "node:fork": "hardhat node --fork $MAINNET_RPC_URL",
    "deploy": "hardhat run scripts/deploy/index.ts --network localhost",
    "deploy:local": "hardhat run scripts/deploy/index.ts --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy/index.ts --network opSepolia",
    "clean": "hardhat clean && forge clean && rm -rf cache_hardhat typechain-types",
    "typechain": "hardhat typechain",
    "verify-setup": "ts-node scripts/verify-setup.ts",
    "bridge:state": "hardhat run scripts/bridge/check-bridge-state.ts --network localhost",
    "bridge:burn": "hardhat run scripts/bridge/bridge-burn-to-solana.ts --network localhost",
    "bridge:relay": "hardhat run scripts/bridge/relay-from-solana.ts --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.6",
    "chai": "^4.3.10",
    "dotenv": "^17.2.3",
    "ethers": "^6.9.2",
    "hardhat": "^2.19.4",
    "hardhat-deploy": "^0.12.1",
    "hardhat-deploy-ethers": "^0.4.2",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "solidity",
    "ethereum",
    "smart-contracts",
    "hardhat",
    "foundry",
    "stablecoin",
    "defi"
  ]
}
