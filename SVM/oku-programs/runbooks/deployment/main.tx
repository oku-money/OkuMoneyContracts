################################################################
# Manage okuMoney deployment through Crypto Infrastructure as Code
################################################################

addon "svm" {
    rpc_api_url = input.rpc_api_url
    network_id = input.network_id
}

action "deploy_lite_psm" "svm::deploy_program" {
    description = "Deploy lite_psm program"
    program = svm::get_program_from_anchor_project("lite_psm") 
    authority = signer.authority
    payer = signer.payer
    // Use instant deployment for Surfnet (fast local testing)
    // This writes program data directly to accounts rather than sending transactions.
    // Devnet/mainnet deployments will still use the standard transaction-based approach.
    instant_surfnet_deployment = true
}

action "deploy_oku_bridge_router" "svm::deploy_program" {
    description = "Deploy oku_bridge_router program"
    program = svm::get_program_from_anchor_project("oku_bridge_router") 
    authority = signer.authority
    payer = signer.payer
    instant_surfnet_deployment = true
}

action "deploy_oku_dollar" "svm::deploy_program" {
    description = "Deploy oku_dollar program"
    program = svm::get_program_from_anchor_project("oku_dollar") 
    authority = signer.authority
    payer = signer.payer
    instant_surfnet_deployment = true
}
