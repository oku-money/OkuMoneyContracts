# OkuMoney EVM — environment variables template.
# Copy to EVM/.env (gitignored) and fill in what you need. Never commit .env.
# Hardhat loads ONLY EVM/.env (dotenv in hardhat.config.ts).
#
# Operator scripts take every option as an ENV VAR (`hardhat run` rejects
# unknown --flags): see scripts/utils/cli.ts. Booleans accept 1 or true.

# ============================================
# Signer and RPC
# ============================================
# Deployer / operator key for live networks (0x-prefixed hex).
PRIVATE_KEY=
# RPC: Alchemy for most chains, Ankr (archive) for pinned forks. Per-chain
# overrides win over both. Resolution: scripts/config/rpc.ts.
ALCHEMY_API_KEY=
ANKR_FREEMIUM_API_KEY=
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARB_SEPOLIA_RPC_URL=
BSC_TESTNET_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=
# Explorer verification. Etherscan V2: one key covers every supported chain.
ETHERSCAN_API_KEY=

# ============================================
# Local forks
# ============================================
# Chain `npm run node` / the in-process network forks (default sepolia).
FORK_NETWORK=
FORK_URL=
FORK_BLOCK_NUMBER=
# Address impersonated as the deployer on forks (default: chains.ts).
DEV_WALLET_ADDRESS=
# Target chain for scripts; auto-detected from a fork node's chainId.
NETWORK=

# ============================================
# Safety switches
# ============================================
# Required to send anything on a mainnet network.
YES_MAINNET=
# Run every check, send nothing.
DRY_RUN=
# Confirmations per tx for role scripts (default 2 live, 1 on forks).
CONFIRMATIONS=

# ============================================
# Deploy (scripts/deploy/index.ts)
# ============================================
# Wire LitePSM to the chain's real USDC instead of MockUSDC (implied on mainnet).
SKIP_MOCK_USDC=
# Ignore address-book entries and redeploy.
FRESH_DEPLOY=
RESET_FORK=

# ============================================
# Upgrades (scripts/upgrade/index.ts — EVM/README.md § Upgrading deployed proxies)
# ============================================
TARGETS=
# direct | propose | verify
MODE=
# Multisig holding the *_UPGRADER roles (propose mode; fork impersonation).
UPGRADE_SAFE=
# Proposal file to close (verify mode).
PROPOSAL=
SKIP_VERIFY=
SKIP_BYTECODE_CHECK=
LOG_CHUNK=

# ============================================
# Role distribution (operator/grantRoles*.ts)
# ============================================
MAINNET_COLD_MULTISIG=
MAINNET_WARM_MULTISIG=
MAINNET_ORCHESTRATOR=
# Testnet: the EOA grantRoles.ts delegates operational roles to.
MASTER_EOA=
MINTER_ALLOWANCE=

# ============================================
# Epoch orchestration PoC (operator/*Epoch*, broadcastSchedule, sampleGlobalValue)
# ============================================
CHAINS=
EPOCH_LENGTH_SECONDS=
EPOCH_ANCHOR_UNIX=
EPOCH_GRID_TOLERANCE_SECONDS=
TOLERANCE_BPS=
EXPIRY_WARN_HOURS=
# The SVM deployment read by globalValue.ts / checkMultiplierDrift.ts and
# written by broadcastSchedule.ts's SVM leg (cluster: SVM_NETWORK, default devnet).
SVM_NETWORK=
SVM_RPC_URL=
SVM_LITE_PSM_PROGRAM_ID=
SVM_OKU_M_MINT=
# "true" once SVM carries real supply. SVM is required in V̄ when configured
# (the three vars above) or when this is set; with neither it is excluded.
SVM_EXPECTED=
# Lifetime of a derived epoch-schedule artifact before broadcast/apply refuse
# it (seconds, default 86400).
ARTIFACT_TTL_SECONDS=

# ============================================
# Gas reporting (npm run test:gas)
# ============================================
REPORT_GAS=
REPORT_GAS_FILE=
COINMARKETCAP_API_KEY=
