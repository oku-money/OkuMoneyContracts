
action "oku_dollar_authority_updated_event" "svm::deploy_subgraph" {
    program_id = action.deploy_oku_dollar.program_id
    program_idl = action.deploy_oku_dollar.program_idl
    block_height = 0 // action.deploy_oku_dollar.block_height
    event {
        name = "AuthorityUpdatedEvent"
    }
}

