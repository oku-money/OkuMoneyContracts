# OkuMoney SVM — environment variables template
# Copy to .env and fill in values. Never commit .env.

# ============================================
# Network selection
# ============================================
# Network: localnet | devnet | devnet-fork | mainnet-beta | mainnet-fork
# Can also be overridden per-command: NETWORK=devnet npm run deploy:programs
NETWORK=localnet

# Wallet path used by deploy / smoke-test scripts. Tilde (~) is expanded via
# os.homedir(). Defaults to ~/.config/solana/id.json.
# This wallet becomes `role_admin` (it must be the BPF upgrade authority).
WALLET_PATH=~/.config/solana/id.json

# Devnet/localnet OPERATOR key — holds the 9 granular PSM authorities.
# MUST be a different key from WALLET_PATH: `initialize` rejects any granular
# authority equal to `role_admin`. Defaults to keys/devnet-authority.json.
# See keys/README.md and SVM/README.md § "Two binding authority constraints".
DEVNET_AUTHORITY_PATH=

# ============================================
# RPC endpoints
# ============================================
# Alchemy / generic API key (used by `scripts/config/networks.ts`).
API_KEY=

# Helius RPC endpoint (used for devnet by default).
HELIUS_RPC=

# Direct RPC override (takes precedence over the network defaults).
SOLANA_RPC_URL=

# ============================================
# Deploy-pipeline tunables
# ============================================
# All optional — see scripts/config/networks.ts for defaults.
PRIORITY_FEE=
MAX_RETRIES=
RETRY_DELAY_MS=
PROGRAM_DELAY_MS=
DEPLOY_TIMEOUT_MS=

# ============================================
# MAINNET authority public keys
# ============================================
# All values must be valid base58 Solana public keys.
# Cold/warm multisigs should be Squads vaults.
# Orchestrators are KMS-backed hot wallets.
# See keys/README.md for the full role↔key mapping.
#
# NOTE: an earlier version of this template also listed
# ORCHESTRATOR_KEYPAIR_PATH, EVM_DEST_CHAIN_ID, EVM_RECIPIENT,
# MAINNET_BRIDGE_ORCHESTRATOR, MAINNET_FEE_RECIPIENT,
# MAINNET_REFUND_INITIATOR and MAINNET_REFUND_CONFIRMER, documenting
# bridge-mint-from-evm.ts / bridge-burn-to-evm.ts and a `bridge_config`
# on-chain account. None of that exists in this workspace — removed rather
# than left as instructions for scripts that were never built.

MAINNET_COLD_MULTISIG=
MAINNET_WARM_MULTISIG=
MAINNET_ORCHESTRATOR=
MAINNET_DIRECT_MINTER=
MAINNET_DIRECT_BURNER=

# ============================================
# Cross-stack epoch orchestration
# (used by EVM/scripts/operator/broadcastSchedule.ts's SVM leg, and by
# EVM's globalValue.ts / checkMultiplierDrift.ts to read this deployment)
# ============================================
SVM_RPC_URL=
SVM_LITE_PSM_PROGRAM_ID=
SVM_OKU_M_MINT=
# Set to "true" once SVM carries real supply — makes a missing/unreadable
# SVM configuration a hard error in globalValue.ts / checkMultiplierDrift.ts
# instead of a silently-inflating warning. See SVM/DECISIONS.md D-27.
SVM_EXPECTED=
