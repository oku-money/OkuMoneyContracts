# ─────────────────────────────────────────────────────────────────────────────
# EVM operator / deploy environment
#
# Copy to `.env` and fill in. Only the SIGNING + RPC block is required for a
# deploy; everything else has a working default or is opt-in per command.
#
# NOTE on flags vs env vars: `npx hardhat run` parses argv itself and rejects
# unrecognised `--flags` (HH305/HH310), so operator options are passed as ENV
# VARS, not flags. See scripts/utils/cli.ts's module doc for the full
# explanation and the camelCase→SCREAMING_SNAKE name mapping.
# ─────────────────────────────────────────────────────────────────────────────

# ── Signing ──────────────────────────────────────────────────────────────────
# Deployer / operator key. Testnet key only — never a mainnet key in a file.
PRIVATE_KEY=
# Optional: expected deployer address. Scripts fail fast if PRIVATE_KEY doesn't
# resolve to this, which catches "wrong key loaded" before it costs a deploy.
MASTER_EOA=

# ── RPC endpoints ────────────────────────────────────────────────────────────
# Each has a public fallback in scripts/config/chains.ts, but public endpoints
# rate-limit hard during a multi-contract deploy. Set real ones for the four
# MVP testnets at minimum.
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARB_SEPOLIA_RPC_URL=
BSC_TESTNET_RPC_URL=
OP_SEPOLIA_RPC_URL=
MAINNET_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=
OPTIMISM_RPC_URL=
ARBITRUM_RPC_URL=
ALCHEMY_API_KEY=

# ── Block explorer verification ──────────────────────────────────────────────
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
BSCSCAN_API_KEY=
OPTIMISTIC_ETHERSCAN_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SVM bridge — REQUIRED once SVM carries any supply
#
# `scripts/utils/globalValue.ts` sums OkuM value across EVERY participating
# chain to produce V̄, the DENOMINATOR of every derived yield rate. SVM is one
# of those chains (config/epochChains.ts includes `solana` by default).
#
# If these are unset, SVM is silently EXCLUDED from V̄ — which does not merely
# make the sample incomplete, it makes the derived rate too HIGH and the
# protocol over-distributes on every chain. If SVM held 20% of supply, V̄ comes
# out 20% low and the rate ~25% high, every epoch, with nothing failing.
#
# SVM_EXPECTED=true converts that silent under-count into a hard error. SET IT
# THE MOMENT SVM IS DEPLOYED AND CARRIES SUPPLY. It is deliberately NOT the
# default because "SVM is absent" is a legitimate pre-launch state that must
# stay distinguishable from "SVM is misconfigured".
# ─────────────────────────────────────────────────────────────────────────────
SVM_RPC_URL=
SVM_LITE_PSM_PROGRAM_ID=
SVM_OKU_M_MINT=
SVM_EXPECTED=false
# Cluster the broadcaster's SVM leg targets (default: devnet).
SVM_NETWORK=devnet

# ── Operator command options (set per-invocation, not usually in .env) ───────
# NETWORK=sepolia              target chain for a deploy/operator script
# CHAINS=sepolia,baseSepolia   scope for sampleGlobalValue / broadcastSchedule /
#                              checkMultiplierDrift. Validated against
#                              config/epochChains.ts; unknown names rejected.
# DRY_RUN=true                 derive + print, submit nothing
# YES_MAINNET=true             required for BOTH the per-tx mainnet guard and
#                              the epoch-scope guard in epochChains.ts
# EPOCH_ID=2026-01             epoch label for derive/broadcast/apply
# PHASE=stage-settlement       or roll-epoch — for runEpoch, deriveEpochSchedule,
#                              broadcastSchedule, applyScheduleSingleChain
# EPOCH_LENGTH_SEC=86400       roll-epoch only. Defaults to the committed grid
#                              in scripts/config/epoch.ts (24h). The contracts
#                              place NO constraint on epoch length — it is
#                              purely a backend scheduling convention. For
#                              internal testing a shorter value (e.g. 3600) is
#                              fine; note the settlement window scales with it
#                              (1/15 of the epoch), as does the time available
#                              to land the schedule on every chain.
# FRESH_DEPLOY=true            skip address-book reuse and redeploy everything
# SKIP_MOCK_USDC=true          use the chain's real USDC instead of MockUSDC
# SKIP_VERIFY=true             skip block-explorer verification
